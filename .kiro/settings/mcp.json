        "Authorization": "Bearer ${CHIMERAFLOW_MCP_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "fetch_records",
        "health_check"
      ]
    },
    "chimeraflow-momo": {
      "url": "https://chimeraflow-mcp.linguasolution.com/mcp/momo",
