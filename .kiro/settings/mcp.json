{
  "mcpServers": {
    "chimeraflow-excel": {
      "url": "https://chimeraflow-mcp.linguasolution.com/mcp/excel",
      "headers": {
        "Authorization": "Bearer ${CHIMERAFLOW_MCP_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "fetch_records",
        "health_check"
      ]
    },
    "chimeraflow-access": {
      "url": "https://chimeraflow-mcp.linguasolution.com/mcp/access",
