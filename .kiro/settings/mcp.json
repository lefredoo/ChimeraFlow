{
  "mcpServers": {
    "chimeraflow-excel": {
      "command": "backend/.venv/Scripts/python.exe",
      "args": ["backend/mcp_main.py", "--source", "excel"],
      "env": {
        "DATA_DIR": "data",
        "ACCESS_READER": "access-parser"
      },
      "disabled": false,
      "autoApprove": ["fetch_records", "health_check"]
    },
    "chimeraflow-access": {
      "command": "backend/.venv/Scripts/python.exe",
      "args": ["backend/mcp_main.py", "--source", "access"],
      "env": {
        "DATA_DIR": "data",
        "ACCESS_READER": "access-parser"
      },
      "disabled": false,
      "autoApprove": ["fetch_records", "health_check"]
    },
    "chimeraflow-whatsapp": {
      "command": "backend/.venv/Scripts/python.exe",
      "args": ["backend/mcp_main.py", "--source", "whatsapp"],
      "env": {
        "DATA_DIR": "data",
        "ACCESS_READER": "access-parser"
      },
      "disabled": false,
      "autoApprove": ["fetch_records", "health_check"]
    },
    "chimeraflow-momo": {
      "command": "backend/.venv/Scripts/python.exe",
      "args": ["backend/mcp_main.py", "--source", "momo"],
      "env": {
        "DATA_DIR": "data",
        "ACCESS_READER": "access-parser"
      },
      "disabled": false,
      "autoApprove": ["fetch_records", "health_check"]
    }
  }
}
