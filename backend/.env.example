# ChimeraFlow Backend Environment Variables
# Copy to .env and fill in your values

# Application
NODE_ENV=development
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (Rate Limiting & Cache)
REDIS_URL=redis://localhost:6379/0

# Database (if using PostgreSQL for rules storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/chimeraflow

# LiteLLM (NL → Rule conversion)
LITELLM_API_KEY=
LITELLM_BUDGET_USD=5.0

# Data Directory
DATA_DIR=../data

# Rate Limiting
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW_SECONDS=60

# MCP Servers (internal communication)
MCP_EXCEL_URL=http://localhost:9001
MCP_ACCESS_URL=http://localhost:9002
MCP_WHATSAPP_URL=http://localhost:9003
MCP_MOMO_URL=http://localhost:9004
