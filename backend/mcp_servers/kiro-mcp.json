{
  "mcpServers": {
    "chimeraflow-excel": {
      "command": "<RACINE_DEPOT>/backend/.venv/Scripts/python.exe",
      "args": [
        "<RACINE_DEPOT>/backend/mcp_main.py",
        "--source",
        "excel"
      ],
      "cwd": "<RACINE_DEPOT>",
      "env": {
        "DATA_DIR": "<RACINE_DEPOT>/data",
        "ACCESS_READER": "access-parser"
      },
      "disabled": false,
      "autoApprove": [
        "fetch_records",
        "health_check"
      ]
    },
    "chimeraflow-access": {
      "command": "<RACINE_DEPOT>/backend/.venv/Scripts/python.exe",
