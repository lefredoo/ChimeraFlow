{
  "id": "r_payment_received",
  "status": "active",
  "natural_language": "Quand un paiement Mobile Money est reçu avec le statut SUCCESS, vérifier s'il correspond à une commande WhatsApp récente.",
  "trigger": {
    "source": "momo",
    "entity": "product",
    "where": [{"field": "status", "op": "eq", "value": "SUCCESS"}]
  },
  "joins": [
    {
      "source": "whatsapp",
      "on": {"entity": "product", "field": "entities"},
      "where": []
    }
  ],
  "window_seconds": 86400,
  "emit": {
    "severity": "info",
    "template": "Paiement reçu : {momo.amount} {momo.currency} pour {product} (commande confirmée)"
  }
}
